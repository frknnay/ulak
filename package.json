{
  "name": "ulak",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm typecheck && pnpm --filter @ulak/client build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ulak/client test:e2e",
    "test:e2e:ui": "pnpm --filter @ulak/client test:e2e:ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "pnpm --filter @ulak/client preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
